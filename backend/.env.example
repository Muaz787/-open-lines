# ── App ──
APP_ENV=development
APP_BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ENCRYPTION_KEY_HEX=

# ── Supabase (database + auth, service role) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── OpenAI (call analysis) ──
OPENAI_API_KEY=

# ── Twilio (phone numbers, SMS, WhatsApp) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ── Vapi (voice AI) ──
VAPI_API_KEY=

# ── Stripe (billing) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_BUSINESS_ANNUAL=
STRIPE_OVERAGE_PRICE_ID=
STRIPE_CALL_MINUTES_PRICE_ID=
SUBSCRIPTION_GRACE_DAYS=7

# ── Pinecone (knowledge base vectors) ──
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_INDEX_HOST=

# ── Firecrawl (website scraping) ──
FIRECRAWL_API_KEY=

# ── Resend (email notifications) ──
RESEND_API_KEY=
EMAIL_FROM=

# ── Google Calendar OAuth ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ── PostHog server-side analytics (optional — no-op when key is unset) ──
POSTHOG_API_KEY=
# US cloud (default). For EU data residency use https://eu.i.posthog.com
POSTHOG_HOST=https://us.i.posthog.com
