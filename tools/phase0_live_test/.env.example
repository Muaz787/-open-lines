# Phase 0 live-test — EXAMPLE environment (names + placeholders ONLY).
# Copy to `.env`, fill locally, NEVER commit `.env`. No secrets live in this file.
#
# Provider credentials (read at --apply time; never printed or logged):
TWILIO_ACCOUNT_SID=__MASTER_SID__
TWILIO_AUTH_TOKEN=__MASTER_TOKEN__
VAPI_API_KEY=__PARENT_ORG_KEY__
VAPI_SERVER_SECRET=__SHARED_WEBHOOK_SECRET__

# Capture service + provisioning. Capture path is /hook/<run_id>, so the tunnel
# URL MUST include the run id:
PHASE0_RUN_ID=run-YYYYMMDD-01                     # unique per run (binds capture path + receipt)
PHASE0_SERVER_URL=https://__YOUR_TUNNEL__/hook/run-YYYYMMDD-01
PHASE0_PORT=8099
PHASE0_BASE=/path/OUTSIDE/the/repo                # operational manifest must NOT be inside the repo
PHASE0_COUNTRY=CA
PHASE0_AREA_CODE=416                              # 3-digit area code (search flow; no explicit-number path)
PHASE0_SPEND_CONTROLS_ACK=yes                     # confirm Twilio usage trigger + Vapi spend limit are set

# Transfer test destination (authorized, domestic, operator-owned):
PHASE0_DEST=+1__AUTHORIZED_DEST__
PHASE0_DEST_ALLOWLIST=+1__AUTHORIZED_REGULAR__,+1__AUTHORIZED_URGENT__
PHASE0_MODE=warm-transfer-say-summary            # or warm-transfer-experimental

# Optional source allow-list (leave blank if forwarded caller-ID is unknown):
PHASE0_SOURCE_ALLOWLIST=
